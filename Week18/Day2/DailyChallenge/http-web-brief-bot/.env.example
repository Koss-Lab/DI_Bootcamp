# Server auth
MCP_HTTP_TOKEN=devtoken123

# Tavily search API
TAVILY_API_KEY=YOUR_TAVILY_KEY_HERE

# LLM provider
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# (Optional) LM Studio
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=llama-3.1-8b-instruct

