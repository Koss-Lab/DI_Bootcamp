# ==============================
# LLM BACKEND CONFIGURATION
# ==============================

# Choose LLM backend: groq or ollama
LLM_BACKEND=groq

# --- GroqCloud ---
GROQ_API_KEY=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
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# ==============================
# MCP SERVERS CONFIGURATION
# ==============================

# Filesystem MCP safety
FILESYSTEM_ALLOWED_DIRS=./workspace

# MCP stdio commands (documented in README)
MCP_FETCH_COMMAND=python
MCP_FETCH_ARGS=-m,mcp_server_fetch

MCP_FILESYSTEM_COMMAND=npx
MCP_FILESYSTEM_ARGS=-y,@modelcontextprotocol/server-filesystem,./workspace

# ==============================
# AGENT SAFETY
# ==============================

MAX_STEPS=10
MAX_RETRIES=2
