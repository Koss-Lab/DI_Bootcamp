# --- LLM backend selection ---
# If GROQ_API_KEY is set -> Groq is used
GROQ_API_KEY=

# If using Ollama instead:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# Groq model (optional)
GROQ_MODEL=llama-3.1-70b-versatile

# --- MCP servers ---
# Directories the filesystem server is allowed to access
FILESYSTEM_ALLOWED_DIRS=./workspace

# Safety
MAX_STEPS=10
MAX_RETRIES=2